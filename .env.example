# Copy to .env and source it as described in README.md. Never commit real keys.
GEMINI_API_KEY=
NOVA_EXTRACTOR_MODEL=gpt-5.4-mini
NOVA_VALIDATOR_MODEL=gpt-5.4-mini
NOVA_CONFIDENCE_THRESHOLD=0.8
NOVA_MAX_RETRIES=2
NOVA_MAX_DOCUMENT_BYTES=10485760
NOVA_MODEL_TIMEOUT_MS=120000
NOVA_EXTRACTOR_MAX_OUTPUT_TOKENS=8192
NOVA_VALIDATOR_MAX_OUTPUT_TOKENS=8192
NOVA_STORAGE_PATH=database/nova.sqlite3

# Provider selection is independent per stage: gemini or openai.
NOVA_EXTRACTOR_PROVIDER=openai
NOVA_VALIDATOR_PROVIDER=openai
OPENAI_API_KEY=
# Gemini is optional: set the stage provider to gemini and its model to a Gemini model.
