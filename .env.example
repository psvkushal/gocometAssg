# Copy to .env and source it as described in README.md. Never commit real keys.
GEMINI_API_KEY=
NOVA_EXTRACTOR_MODEL=gemini-2.5-pro
NOVA_VALIDATOR_MODEL=gemini-2.5-flash
NOVA_CONFIDENCE_THRESHOLD=0.8
NOVA_MAX_RETRIES=2
NOVA_MAX_DOCUMENT_BYTES=10485760
NOVA_MODEL_TIMEOUT_MS=120000
NOVA_EXTRACTOR_MAX_OUTPUT_TOKENS=8192
NOVA_VALIDATOR_MAX_OUTPUT_TOKENS=8192
NOVA_STORAGE_PATH=data/nova.sqlite3

# Provider selection is independent per stage: gemini or openai.
NOVA_EXTRACTOR_PROVIDER=gemini
NOVA_VALIDATOR_PROVIDER=gemini
OPENAI_API_KEY=
# For GPT validation: set NOVA_VALIDATOR_PROVIDER=openai and
# NOVA_VALIDATOR_MODEL=gpt-5.4-nano (or gpt-5.4-mini).
